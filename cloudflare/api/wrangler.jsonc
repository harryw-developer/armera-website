{
  "name": "armera-api",
  "main": "index.js",
  "compatibility_date": "2026-10-23",
  "d1_databases": [
    { "binding": "DB", "database_name": "armera", "database_id": "3a4d04bb-effb-4da0-bc7c-d55e3ffcd8e0" }
  ],
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "armera-assets" },
    { "binding": "INSTRUCTIONS", "bucket_name": "armera-instructions" },
    { "binding": "PROOF", "bucket_name": "armera-guarantee-proof" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  // The public site reads from the workers.dev address; adding a route
  // switches it off unless it is asked for explicitly.
  "workers_dev": true
}
